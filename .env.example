# Opcional. Usados só na primeira vez, quando ainda não existe administrador.
ADMIN_USER=admin
ADMIN_PASSWORD=futebol123

# Segredo da sessão. Troque se o app for ficar acessível fora da sua máquina.
AUTH_SECRET=troque-por-uma-frase-longa

# Banco na nuvem (Turso, plano grátis). Sem isso, os dados ficam em data/futebol.db.
# Na Vercel esses dois são obrigatórios, senão a lista some a cada visita.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
